@startuml sequence-tour
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam ArrowColor #3A4170
skinparam sequence {
  ParticipantBackgroundColor #FFFFFF
  ParticipantBorderColor #555555
  LifeLineBorderColor #888888
  GroupBackgroundColor #F2F2F2
}
title Fakemon Arena · résolution d'un tour contre l'IA

actor Joueur
participant "BattleScreen" as Ecran #FFF6D6
participant "DefaultBattleEngine" as Arbitre #DCE8F7
participant "RandomOpponent" as IA #DCE8F7
participant "DamageCalculator" as Calcul #DCE8F7
participant "Fakemon cible" as Cible #DCE8F7

Joueur -> Ecran : attaque ou changement
Ecran -> Ecran : verrouiller les commandes
Ecran -> Arbitre : submitAction(playerAction)
activate Arbitre
Arbitre -> IA : chooseAction(moves, standingFakemons)
IA --> Arbitre : opponentAction
Arbitre -> Arbitre : changements avant les attaques
opt un ou deux changements
  Arbitre -> Arbitre : vérifier les remplaçants
  Arbitre -> Arbitre : si deux changements, départ du plus rapide
  Arbitre -> Ecran : FakemonEnteredEvent
  opt le Fakemon entrant tient un objet
    Arbitre -> Ecran : ItemActivatedEvent
  end
  opt Fracas inflige des dégâts à l'entrée
    Arbitre -> Cible : takeDamage(entryDamage)
    Arbitre -> Ecran : TalentActivatedEvent
    Arbitre -> Ecran : HpLostEvent
  end
end
Arbitre -> Arbitre : attaques par priorité, puis vitesse, puis hasard

loop chaque attaque autorisée, avec un attaquant encore debout
  Arbitre -> Ecran : MoveUsedEvent
  Arbitre -> Calcul : rollAccuracy(move)
  Calcul --> Arbitre : touché ou raté
  alt attaque ratée
    Arbitre -> Ecran : MoveMissedEvent
  else attaque réussie
    Arbitre -> Calcul : calculate(attacker, target, move)
    note right of Calcul
      Utilise les statistiques avec l'objet tenu.
      Applique Dernier Souffle et Carapace.
    end note
    Calcul --> Arbitre : DamageResult
    alt cible immunisée
      Arbitre -> Ecran : EffectivenessEvent(NO_EFFECT)
    else cible sensible à l'attaque
      Arbitre -> Cible : takeDamage(damage)
      opt coup critique
        Arbitre -> Ecran : CriticalHitEvent
      end
      opt efficacité différente de ×1
        Arbitre -> Ecran : EffectivenessEvent
      end
      opt Dernier Souffle activé
        Arbitre -> Ecran : TalentActivatedEvent pour l'attaquant
      end
      opt Carapace activée
        Arbitre -> Ecran : TalentActivatedEvent pour la cible
      end
      Arbitre -> Ecran : HpLostEvent
      opt la cible est K.O.
        Arbitre -> Ecran : FakemonFaintedEvent
      end
    end
  end
end

opt Récupération rend des PV
  Arbitre -> Arbitre : si deux soins, traiter le plus rapide d'abord
  Arbitre -> Ecran : TalentActivatedEvent
  Arbitre -> Ecran : HpRestoredEvent
end

alt le joueur n'a plus de Fakemon debout
  Arbitre -> Ecran : BattleEndedEvent(OPPONENT, ALL_FAINTED)
else l'IA n'a plus de Fakemon debout
  Arbitre -> Ecran : BattleEndedEvent(PLAYER, ALL_FAINTED)
else le Fakemon actif du joueur est K.O.
  Arbitre -> Ecran : FakemonSelectionRequiredEvent(REPLACEMENT)
  note right of Ecran
    Le moteur attend SendFakemon.
    Si le Fakemon adverse est K.O. aussi,
    son remplaçant est demandé à ce moment.
    Les deux entrées sont alors annoncées,
    puis le tour suivant commence.
  end note
else seul le Fakemon actif adverse est K.O.
  Arbitre -> IA : chooseFakemon(standingFakemons)
  IA --> Arbitre : SendFakemon
  Arbitre -> Arbitre : entrée du remplaçant, objet et Fracas éventuels
  Arbitre -> Ecran : événements d'entrée
  Arbitre -> Ecran : TurnStartedEvent
else les deux Fakemon actifs sont debout
  Arbitre -> Ecran : TurnStartedEvent
end
Arbitre --> Ecran : fin de submitAction
deactivate Arbitre
Ecran -> Ecran : afficher les événements dans l'ordre
Ecran --> Joueur : prochain choix ou bilan du combat

legend bottom left
  Ce parcours décrit le combat contre l'IA sur le thread JavaFX.
  Les événements sont mis en file par l'écran pendant submitAction.
  Un abandon en attente d'action émet BattleEndedEvent(OPPONENT, FORFEIT).
  Les changements simultanés sont appliqués successivement dans l'ordre de vitesse.
endlegend
@enduml
