@startuml
actor Joueur
participant BattleScreen
participant DefaultBattleEngine
participant RandomOpponent
participant SceneManager
participant BattleEndScreen
Joueur -> BattleScreen : attaque, changement ou abandon
BattleScreen -> BattleScreen : verrouiller les commandes
BattleScreen -> DefaultBattleEngine : submitAction(action)
opt Tour normal
    DefaultBattleEngine -> RandomOpponent : chooseAction(...)
    RandomOpponent --> DefaultBattleEngine : action adverse
end
DefaultBattleEngine -> BattleScreen : onEvent(...) en ordre
DefaultBattleEngine --> BattleScreen : retour
BattleScreen -> BattleScreen : afficher les événements
alt Fin de combat
    BattleScreen -> SceneManager : show(BattleEndScreen)
    alt Revanche
        Joueur -> BattleEndScreen : clic Revanche
        BattleEndScreen -> SceneManager : ouvrir un nouvel écran de combat
    else Menu
        Joueur -> BattleEndScreen : clic Menu
        BattleEndScreen -> SceneManager : afficher le menu
    end
else Remplacement obligatoire
    BattleScreen -> Joueur : demander un remplaçant valide
else Tour suivant
    BattleScreen -> BattleScreen : réactiver les commandes
end
@enduml
