@startuml cas-utilisation
!pragma layout smetana
title Fakemon Arena · cas d'utilisation (v1)
left to right direction
skinparam actorStyle awesome
skinparam defaultFontName Segoe UI
skinparam usecase {
  BackgroundColor #FFF6D6
  BorderColor #B8901A
}
skinparam rectangle {
  BorderColor #3A4170
  BackgroundColor #FAFAFD
}

actor "Joueur" as joueur
actor "Ordinateur" as ia

rectangle "Fakemon Arena" {
  usecase "Jouer contre l'ordinateur" as jouer
  usecase "Tirer les équipes" as tirer
  usecase "Relancer le tirage" as relancer
  usecase "Jouer un tour" as tour
  usecase "Attaquer" as attaquer
  usecase "Changer de fakemon" as changer
  usecase "Remplacer un fakemon KO" as remplacer
  usecase "Voir le résultat\net rejouer" as resultat

  usecase "Ajouter un fakemon" as ajouter
  usecase "Saisir les noms,\ntypes et stats" as saisir
  usecase "Choisir les sprites\n(face, dos facultatif)" as sprites
  usecase "Choisir le cri" as cri
  usecase "Choisir les attaques\ndisponibles" as attaques
  usecase "Valider et enregistrer\nla fiche" as valider

  usecase "Régler le volume" as volume
}

joueur --> jouer
joueur --> ajouter
joueur --> volume

jouer ..> tirer : <<include>>
jouer ..> tour : <<include>>
jouer ..> resultat : <<include>>
relancer ..> tirer : <<extend>>
attaquer --|> tour
changer --|> tour
remplacer ..> tour : <<extend>>\nsi le fakemon est KO

tour -- ia

ajouter ..> saisir : <<include>>
ajouter ..> sprites : <<include>>
ajouter ..> cri : <<include>>
ajouter ..> attaques : <<include>>
ajouter ..> valider : <<include>>

note bottom of ia
  Choisit son action à chaque tour
  (AiController.chooseAction)
  et remplace ses fakemon KO.
end note

note right of valider
  Refusée si : nom déjà pris,
  stats > 600, moins de 4 attaques,
  sprite de face ou cri manquant.
end note
@enduml
