@startuml cas-utilisation
!pragma layout smetana
left to right direction
skinparam actorStyle awesome
skinparam defaultFontName Segoe UI
skinparam usecase {
  BackgroundColor #FFF6D6
  BorderColor #B8901A
}
skinparam rectangle {
  BorderColor #3A4170
  BackgroundColor #FAFAFD
}
title Fakemon Arena · cas d'utilisation, vue d'ensemble (v1)

actor "Joueur" as joueur
actor "Ordinateur" as ia
actor "Adversaire en ligne\n(bonus)" as adv

rectangle "Fakemon Arena" {
  usecase "Jouer un combat\nen ligne (bonus)" as jouerLigne
  usecase "Jouer un combat\ncontre l'IA" as jouerIA
  usecase "Consulter le Mondex" as mondex
  usecase "Ajouter un Mon" as ajouter
}

joueur --> jouerLigne
joueur --> jouerIA
joueur --> mondex
joueur --> ajouter
jouerIA -- ia
jouerLigne -- adv

note as detail
  Le détail de chaque cas est dans
  son propre diagramme (cu-*.puml).
end note
@enduml
