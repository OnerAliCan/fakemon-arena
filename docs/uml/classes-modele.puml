@startuml classes-modele
!pragma layout smetana
skinparam dpi 110
set separator none
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF8DC
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
title Fakemon Arena · modèle et effets

package "core.model" {
  enum Type <<#8>> {
    FIRE
    WATER
    NATURE
    LIGHTNING
    ROCK
    WIND
    VENOM
    FORCE
    SHADOW
    ETHER
  }

  enum MoveCategory <<#8>> {
    PHYSICAL
    SPECIAL
    STATUS
  }

  enum StatusType <<#32>> {
    BURN
    POISON
    PARALYSIS
    SLEEP
    CONFUSION
    --
    + create() : Status
    + getDisplayName() : String
  }

  class Move <<#8>> {
    - name : String
    - type : Type
    - category : MoveCategory
    - power : int
    - accuracy : int
    - priority : int
    - status : StatusType
    - statusChance : int
    --
    + Move(name, type, category, power, accuracy, priority)
    + Move(name, type, category, power, accuracy, priority, status, statusChance)
    + getters
  }

  interface Stats <<#8>> {
    + getHp() : int
    + getAttack() : double
    + getDefense() : double
    + getSpecialAttack() : double
    + getSpecialDefense() : double
    + getSpeed() : double
  }

  class BaseStats <<#8>> {
    - hp : int
    - attack : int
    - defense : int
    - specialAttack : int
    - specialDefense : int
    - speed : int
    --
    + BaseStats(hp, attack, defense, specialAttack, specialDefense, speed)
    + les 6 méthodes de Stats
  }

  class Species <<#8>> {
    - originalName : String
    - frenchName : String
    - types : List<Type>
    - stats : Stats
    - possibleMoves : List<Move>
    - talent : Talent
    - dexNumber : int
    - coverageType : Type
    - concept : String
    - designer : String
    - frontSprite : String
    - backSprite : String
    - cry : String
    --
    - Species(builder : Builder)
    + getters
  }

  class "Species.Builder" as SpeciesBuilder <<#22>> {
    + Builder()
    + méthodes de configuration renvoyant Builder
    + build() : Species
  }

  class Fakemon <<#8>> {
    - species : Species
    - moves : List<Move>
    - currentHp : int
    - item : Item
    - battleStats : Stats
    - status : Status
    --
    + Fakemon(species, moves)
    + getSpecies() : Species
    + getMoves() : List<Move>
    + getStats() : Stats
    + getMaxHp() : int
    + getCurrentHp() : int
    + isFainted() : boolean
    + takeDamage(damageTaken : int) : void
    + heal(healedHp : int) : void
    + getItem() : Item
    + equip(item : Item) : void
    + getStatus() : Status
    + applyStatus(effect : Status) : boolean
    + clearStatus() : void
  }

  class Team <<#8>> {
    - fakemons : List<Fakemon>
    --
    + Team(fakemons : List<Fakemon>)
    + getFakemons() : List<Fakemon>
    + getStandingFakemons() : List<Fakemon>
    + hasStandingFakemon() : boolean
  }

  enum Item <<#24>> {
    GANTELET
    ECU
    PLUME
    --
    + getDisplayName() : String
    + decorate(base : Stats) : Stats
  }

  enum Talent <<#22>> {
    CARAPACE
    DERNIER_SOUFFLE
    FRACAS
    RECUPERATION
  }
}

package "core.effects" {
  abstract class Status <<#32>> {
    + getType() : StatusType
    + canApply(target : Fakemon) : boolean
    + decorate(stats : Stats) : Stats
    + preventsAttack(random : Random) : boolean
    + preventedAttackDamage(holder : Fakemon) : int
    + hasEnded() : boolean
    + endOfTurnDamage(holder : Fakemon) : int
  }
  class Burn
  class Poison
  class Paralysis
  class Sleep {
    - remaining : int
    - ended : boolean
  }
  class Confusion {
    - remaining : int
  }
  class ItemStats <<#24>> {
    - base : Stats
    - attack : double
    - defense : double
    - speed : double
    + ItemStats(base, attack, defense, speed)
    + les 6 méthodes de Stats
  }
  abstract class Ability <<#24>> {
    + receivedDamageMultiplier(defender, typeMultiplier) : double
    + dealtDamageMultiplier(attacker) : double
    + entryDamage(entrant, target) : int
    + endOfTurnHeal(holder) : int
  }
  class Carapace
  class DernierSouffle
  class Fracas
  class Recuperation
}

BaseStats ..|> Stats
ItemStats ..|> Stats
ItemStats o--> "1" Stats : enveloppe
Item ..> ItemStats : crée
Carapace --|> Ability
DernierSouffle --|> Ability
Fracas --|> Ability
Recuperation --|> Ability
Burn --|> Status
Poison --|> Status
Paralysis --|> Status
Sleep --|> Status
Confusion --|> Status
Paralysis ..> ItemStats : vitesse ×0,5
StatusType ..> Status : crée

SpeciesBuilder ..> Species : construit
Species --> "1" Stats
Species --> "1..2" Type
Species --> "4..*" Move : possibleMoves
Species --> "1" Talent
Fakemon --> "1" Species
Fakemon --> "4" Move : moves
Fakemon --> "0..1" Item
Fakemon --> "0..1" ItemStats : battleStats
Fakemon *--> "0..1" Status : état de combat
Team o--> "6 au plus" Fakemon
Move --> "1" Type
Move --> "1" MoveCategory
Move --> "0..1" StatusType : effet possible

legend bottom left
  <b>Decorator (ItemStats)</b> : chaque objet crée une vue des stats de base et applique son bonus de 20 %.
  <b>Talent</b> : la fiche conserve un identifiant. Les classes Ability appliquent les effets en combat.
  <b>State (Status)</b> : chaque Fakemon possède au plus un état ; le moteur lui délègue les effets avant l'attaque et en fin de tour.
  <b>Fakemon</b> : une exception si moves ne contient pas 4 attaques. getStats() applique l'objet puis le statut. currentHp reste entre 0 et getMaxHp().
  <b>Statuts</b> : pas de remplacement d'un état existant ; compteurs figés sur le banc et nettoyage en fin de combat.
  <b>Team</b> accepte de 0 à 6 Fakemon. getStandingFakemons() crée une liste des membres encore debout.
  <b>Builder</b> vérifie la présence des champs obligatoires. JsonSpeciesRepository valide les valeurs du catalogue.
  <b>Stats</b> : des double, car le GDD n'arrondit les dégâts qu'à la fin. Les objets ne changent jamais les PV : getHp() reste un int.
endlegend
@enduml
