@startuml navigation
!pragma layout smetana
title Fakemon Arena · menu principal, version livrée
skinparam defaultFontName Segoe UI
skinparam state {
  BackgroundColor #FFF6D6
  BorderColor #B8901A
  ArrowColor #3A4170
}
hide empty description

state "Menu principal" as Menu
state "Combat en LAN" as Ligne : voir combat-en-ligne.puml
state "Combat contre l'IA" as IA : voir combat-ia.puml
state "Mondex" as Mondex : voir mondex.puml
state "Ajouter un Mon" as Ajouter : écran provisoire\nformulaire prévu dans #20
state "Options" as Options : volume de la musique\net des effets
state "Crédits" as Credits

[*] --> Menu
Menu --> Ligne
Menu --> IA
Menu --> Mondex
Menu --> Ajouter
Menu --> Options
Menu --> Credits
Ligne --> Menu : Retour
IA --> Menu : Retour
Mondex --> Menu : Retour ou Échap
Ajouter --> Menu : Retour
Options --> Menu : Fermer la fenêtre de volume
Credits --> Menu : Retour ou Échap
Menu --> [*] : Quitter

note right of Menu
  Boutons, dans l'ordre : Combat en ligne,
  Combat contre l'IA, Mondex, Ajouter un Mon,
  Options, Crédits, Quitter.
  Les écrans de combat, le lobby LAN,
  le Mondex et les crédits gèrent Échap.
  Les autres parcours proposent un bouton Retour.
end note
@enduml
