@startuml navigation
!pragma layout smetana
title Fakemon Arena · menu principal (v1)
skinparam defaultFontName Segoe UI
skinparam state {
  BackgroundColor #FFF6D6
  BorderColor #B8901A
  ArrowColor #3A4170
}
hide empty description

state "Menu principal" as Menu
state "Combat en ligne\n(bonus)" as Ligne : voir combat-en-ligne.puml
state "Combat contre l'IA" as IA : voir combat-ia.puml
state "Mondex" as Mondex : voir mondex.puml
state "Ajouter un Mon" as Ajouter : voir ajouter-un-mon.puml
state "Options" as Options : volume de la musique\net des effets
state "Crédits" as Credits

[*] --> Menu
Menu --> Ligne
Menu --> IA
Menu --> Mondex
Menu --> Ajouter
Menu --> Options
Menu --> Credits
Menu --> [*] : Quitter

note right of Menu
  Boutons, dans l'ordre : Combat en ligne,
  Combat contre l'IA, Mondex, Ajouter un Mon,
  Options, Crédits, Quitter.
  Sur chaque écran, Échap ou Retour
  ramène à l'écran précédent.
end note
@enduml
