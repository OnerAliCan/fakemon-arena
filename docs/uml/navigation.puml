@startuml navigation
!pragma layout smetana
title Fakemon Arena · navigation entre les écrans (v1)
skinparam defaultFontName Segoe UI
skinparam state {
  BackgroundColor #FFF6D6
  BorderColor #B8901A
  ArrowColor #3A4170
}
hide empty description

state "Menu principal" as Menu
state "Options\n(volume)" as Options
state "Dashboard\n(ajouter un fakemon)" as Dashboard
state "Aperçu des équipes" as Apercu
state "Fin de combat" as Fin

state "Combat" as Combat {
  state "Choix de l'action" as Choix
  state "Résolution du tour\n(animations, journal)" as Resolution
  state "Panneau d'équipe" as Panneau
  state "Remplacement forcé\n(panneau sans Retour)" as Remplacement

  [*] --> Choix
  Choix --> Resolution : clic sur une attaque
  Choix --> Panneau : bouton Équipe
  Panneau --> Choix : Retour
  Panneau --> Resolution : Envoyer
  Resolution --> Choix : tour terminé
  Resolution --> Remplacement : fakemon du joueur KO
  Remplacement --> Choix : Envoyer
}

[*] --> Menu
Menu --> Apercu : Nouveau combat\n(tirage)
Apercu --> Apercu : Nouveau tirage
Apercu --> Menu : Retour
Apercu --> Combat : Combattre !
Combat --> Fin : un camp n'a plus\nde fakemon debout
Fin --> Combat : Revanche\n(mêmes équipes)
Fin --> Apercu : Nouveau tirage
Fin --> Menu : Menu
Menu --> Dashboard : Ajouter un fakemon
Dashboard --> Menu : Enregistrer / Annuler
Menu --> Options : Options
Options --> Menu : Fermer
Menu --> [*] : Quitter
@enduml
