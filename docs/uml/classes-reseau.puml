@startuml classes-reseau
!pragma layout smetana
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
hide empty members
title Fakemon Arena · classes du réseau LAN
interface Opponent
interface BattleState
class NetworkMessage {
  - type : String
  - payload : JsonObject
}
class NetworkMessageCodec {
  + encode(message) : String
  + decode(json) : NetworkMessage
}
class NetworkActionCodec {
  + encode(action, team, active) : NetworkMessage
  + decode(message, team, active) : PlayerAction
}
class NetworkEventCodec {
  + encode(event) : NetworkMessage
  + encodeSelection(event, recipient) : NetworkMessage
  + decode(message) : Optional<BattleEvent>
}
class NetworkTeamCodec {
  + encode(team) : NetworkMessage
  + decode(message) : Team
}
class NetworkConnection {
  + send(message)
  + receive() : NetworkMessage
  + close()
}
class NetworkHost {
  + accept() : NetworkConnection
  + getPort() : int
  + close()
}
class NetworkClient {
  + {static} connect(address, port) : NetworkConnection
}
class NetworkOpponent {
  + chooseAction(moves, standing) : PlayerAction
  + chooseFakemon(standing) : PlayerAction
  + submitAction(action)
  + close()
}
class NetworkOpponentChannel {
  + chooseAction(moves, standing) : PlayerAction
  + chooseFakemon(standing) : PlayerAction
  + receiveAction(message)
  + close()
}
class NetworkBattleCoordinator {
  + start()
  + submitHostAction(message) : CompletableFuture<Void>
  + cancelHostAction(requestId) : CompletableFuture<Boolean>
  + close()
}
class NetworkGuestSession {
  + start()
  + submitAction(message) : CompletableFuture<Void>
  + cancelAction(requestId) : CompletableFuture<Void>
  + close()
}
class NetworkPreparationSession {
  + startMonitoring(onFailure)
  + awaitReady()
  + ready()
  + start(mode)
  + awaitStart() : BattleMode
  + sendSelection(names)
  + receiveSelection() : List<String>
  + finish()
  + close()
}
class NetworkPreparationScreen
class NetworkBattleState {
  + getTeam(side) : Team
  + getActiveFakemon(side) : Fakemon
  + getTurnNumber() : int
  + apply(event)
}
class NetworkBattleController
class NetworkLobbyScreen
class BattleScreen
class DefaultBattleEngine
abstract class BattleEvent
class StatusAppliedEvent
class StatusActivatedEvent
class StatusRemovedEvent
class AttackPreventedEvent
NetworkConnection --> NetworkMessageCodec
NetworkMessageCodec --> NetworkMessage
NetworkHost ..> NetworkConnection
NetworkClient ..> NetworkConnection
NetworkOpponent ..|> Opponent
NetworkOpponentChannel ..|> Opponent
NetworkBattleState ..|> BattleState
NetworkOpponentChannel *-- NetworkOpponent
NetworkOpponentChannel --> NetworkActionCodec
NetworkOpponentChannel --> NetworkConnection
NetworkBattleCoordinator *-- DefaultBattleEngine
NetworkBattleCoordinator *-- NetworkOpponentChannel
NetworkBattleCoordinator --> NetworkEventCodec
NetworkBattleCoordinator --> NetworkTeamCodec
NetworkGuestSession --> NetworkConnection
NetworkBattleController --> NetworkBattleCoordinator
NetworkBattleController --> NetworkGuestSession
NetworkBattleController *-- NetworkBattleState
NetworkBattleController --> NetworkEventCodec
BattleScreen --> NetworkBattleController
NetworkLobbyScreen ..> NetworkHost
NetworkLobbyScreen ..> NetworkClient
NetworkLobbyScreen ..> NetworkPreparationScreen
NetworkPreparationScreen *-- NetworkPreparationSession
NetworkPreparationScreen ..> NetworkBattleController : transfère la connexion
NetworkPreparationSession --> NetworkConnection
note right of NetworkPreparationSession
  Lit en continu pendant la préparation.
  PREPARATION_END puis PREPARATION_ACK
  arrêtent les lecteurs avant le combat.
end note
StatusAppliedEvent --|> BattleEvent
StatusActivatedEvent --|> BattleEvent
StatusRemovedEvent --|> BattleEvent
AttackPreventedEvent --|> BattleEvent
NetworkEventCodec ..> BattleEvent : encode et décode les statuts
note right of NetworkBattleState
  Applique et retire les statuts annoncés.
  Efface les statuts à la fin du combat.
  Seul l'hôte fait les tirages et avance les compteurs.
end note
@enduml
