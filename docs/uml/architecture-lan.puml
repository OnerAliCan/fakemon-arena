@startuml architecture-lan
!pragma layout smetana
skinparam dpi 110
skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam packageStyle rectangle
title Fakemon Arena · architecture du combat LAN

package "PC de l'hôte" {
  [NetworkLobbyScreen] as LobbyHost
  [BattleScreen] as ScreenHost
  [NetworkBattleController] as ControllerHost
  [NetworkBattleCoordinator] as Coordinator
  [DefaultBattleEngine] as Engine
  [NetworkOpponentChannel] as Channel
  [NetworkOpponent] as Opponent
  [NetworkConnection] as ConnectionHost
  [NetworkBattleState] as StateHost
}
package "PC de l'invité" {
  [NetworkLobbyScreen] as LobbyGuest
  [BattleScreen] as ScreenGuest
  [NetworkBattleController] as ControllerGuest
  [NetworkGuestSession] as Guest
  [NetworkConnection] as ConnectionGuest
  [NetworkBattleState] as StateGuest
}
LobbyHost --> ControllerHost : connexion acceptée
LobbyGuest --> ControllerGuest : connexion ouverte
ScreenHost --> ControllerHost : choix du joueur
ControllerHost --> Coordinator : submitHostAction
Coordinator --> Engine : start, submitAction
Engine --> Channel : chooseAction, chooseFakemon
Channel --> Opponent : attend le choix distant
Coordinator --> Channel : réponse lue sur le réseau
Channel --> ConnectionHost : ACTION_REQUIRED
Coordinator --> ConnectionHost : BATTLE_START, EVENT
Coordinator --> ControllerHost : messages locaux
ControllerHost --> StateHost : applique les événements
ControllerHost --> ScreenHost : événements et choix attendu
ScreenGuest --> ControllerGuest : choix du joueur
ControllerGuest --> Guest : submitAction
Guest --> ConnectionGuest : ACTION
ConnectionHost <--> ConnectionGuest : TCP UTF-8, port 5000, un message JSON par ligne
Guest --> ControllerGuest : messages reçus
ControllerGuest --> StateGuest : applique les événements
ControllerGuest --> ScreenGuest : événements et choix attendu

note bottom of Coordinator
  Un thread résout le combat.
  Un autre lit les actions de l'invité.
  Les demandes portent un identifiant.
end note
note bottom of ControllerGuest
  Platform.runLater applique les messages sur JavaFX.
  NetworkEventCodec adapte les camps à l'invité.
  Les équipes locales conservent les PV et les actifs.
end note
@enduml
