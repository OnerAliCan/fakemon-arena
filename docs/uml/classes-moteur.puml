@startuml classes-moteur
!pragma layout smetana
skinparam dpi 110
set separator none
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam packageStyle rectangle
skinparam noteBackgroundColor #FFF8DC
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #555555
title Fakemon Arena · moteur, générateur, IA et données

package "core.api" {
  interface BattleEngine {
    + addListener(listener) : void
    + start(playerTeam, opponentTeam, battleMode, opponent, random) : void
    + submitAction(playerAction) : void
    + getState() : BattleState
  }
  interface BattleState {
    + getTeam(side) : Team
    + getActiveFakemon(side) : Fakemon
    + getTurnNumber() : int
  }
  interface BattleListener {
    + onEvent(event : BattleEvent) : void
  }
  abstract class BattleEvent
  class StatusAppliedEvent <<#32>>
  class StatusActivatedEvent <<#32>>
  class StatusRemovedEvent <<#32>>
  class AttackPreventedEvent <<#32>>
  interface Opponent {
    + chooseAction(moveList, standingFakemonList) : PlayerAction
    + chooseFakemon(standingFakemonList) : PlayerAction
  }
  interface TeamGenerator {
    + randomTeam(excludedSpecies) : Team
    + buildTeam(chosenSpecies) : Team
  }
  interface SpeciesRepository {
    + findAll() : List<Species>
    + findByOriginalName(originalName) : Optional<Species>
    + add(species) : void
  }
  abstract class PlayerAction
  enum Effectiveness
}

package "core.engine" {
  class TypeChart <<#9>> {
    - table : double[][]
    --
    + TypeChart()
    + multiplier(attack : Type, defender : List<Type>) : double
    + toEffectiveness(multiplier : double) : Optional<Effectiveness>
  }

  class DamageCalculator <<#9>> {
    - random : Random
    - typeChart : TypeChart
    - carapace : Ability
    - dernierSouffle : Ability
    --
    + DamageCalculator(random, typeChart)
    + rollAccuracy(move : Move) : boolean
    + calculate(attacker : Fakemon, target : Fakemon, move : Move) : DamageResult
  }

  class DamageResult <<#9>> {
    - damage : int
    - critical : boolean
    - multiplier : double
    - attackerTalent : Talent
    - defenderTalent : Talent
    --
    + DamageResult(damage, critical, multiplier)
    + DamageResult(damage, critical, multiplier, attackerTalent, defenderTalent)
    + getters
  }

  class TeamDrafter <<#10>> {
    - {static} MINIMUM_SPECIES : int = 12
    - speciesRepository : SpeciesRepository
    - random : Random
    --
    + TeamDrafter(speciesRepository, random)
    + randomTeam(excludedSpecies) : Team
    + buildTeam(chosenSpecies) : Team
    - createFakemon(species) : Fakemon
  }

  class DefaultBattleEngine <<#17>> {
    - listeners : List<BattleListener>
    - playerTeam : Team
    - opponentTeam : Team
    - activePlayerFakemon : Fakemon
    - activeOpponentFakemon : Fakemon
    - opponent : Opponent
    - damageCalculator : DamageCalculator
    - random : Random
    - turnNumber : int
    - phase : BattlePhase
    - typeChart : TypeChart
    - fracas : Ability
    - recuperation : Ability
    --
    + les 4 méthodes de BattleEngine
    + les 3 méthodes de BattleState
    - resolveTurn(opponentAction, playerAction) : void
    - fasterSide() : Side
    - useMove(side, move) : void
    - applyMoveStatus(side, target, move) : void
    - applyEndOfTurnStatus(side) : void
    - endBattle(winner, reason) : void
    - sendFakemon(side, fakemon) : void
    - checkCanEnter(side, fakemon) : void
    - otherSide(side) : Side
    - announceBothEntries(first) : void
    - announceEntry(side) : void
    - applyFracas(side) : void
    - applyEndOfTurnTalents() : void
    - applyRecovery(side, amount) : void
    - chooseOpponentReplacement() : Fakemon
    - applyEndOfTurn() : void
    - startNextTurn() : void
    - notifyListeners(event) : void
  }

  enum BattlePhase <<#17>> {
    WAITING_FIRST_FAKEMON
    WAITING_ACTION
    WAITING_REPLACEMENT
    FINISHED
  }
}

package "core.ai" {
  class RandomOpponent <<#11>> {
    - random : Random
    --
    + RandomOpponent(random)
    + chooseAction(moveList, standingFakemonList) : PlayerAction
    + chooseFakemon(standingFakemonList) : PlayerAction
  }
}

package "data" {
  class InMemorySpeciesRepository {
    - speciesList : List<Species>
    + InMemorySpeciesRepository()
    + InMemorySpeciesRepository(species)
    + les 3 méthodes de SpeciesRepository
  }
  class JsonSpeciesRepository <<#22>> {
    - speciesList : List<Species>
    - movesById : Map<String, Move>
    - factory : SpeciesFactory
    - userFolder : Path
    --
    + JsonSpeciesRepository(factory, userFolder)
    + les 3 méthodes de SpeciesRepository
    - load() : void
    - readBuiltInFile() : JsonObject
    - loadUserSpecies() : void
    - loadUserFile(file : Path) : void
    - validateSpecies(species : Species) : void
  }
  class SpeciesFactory <<#22>> {
    + createSpecies(json, movesById) : Species
    + createMove(json) : Move
  }
  class BundledRoster {
    - BundledRoster()
    + {static} load() : SpeciesRepository
  }
}

package "core.effects" {
  abstract class Ability
  abstract class Status
}

package "ui (Matteo)" {
  class "Écran de combat" as CombatScreen <<#13, #26>>
}

DefaultBattleEngine ..|> BattleEngine
DefaultBattleEngine ..|> BattleState
DefaultBattleEngine o--> "*" BattleListener : prévient
DefaultBattleEngine --> "1" Opponent : interroge
DefaultBattleEngine *--> "1" DamageCalculator
DefaultBattleEngine --> "1" TypeChart
DefaultBattleEngine --> "1" BattlePhase
DefaultBattleEngine ..> BattleEvent : envoie
DefaultBattleEngine ..> PlayerAction : reçoit
StatusAppliedEvent --|> BattleEvent
StatusActivatedEvent --|> BattleEvent
StatusRemovedEvent --|> BattleEvent
AttackPreventedEvent --|> BattleEvent
DefaultBattleEngine ..> Status : avant l'attaque et en fin de tour

DamageCalculator --> "1" TypeChart
DamageCalculator --> "2" Ability : modifie les dégâts
DefaultBattleEngine --> "2" Ability : entrée et fin de tour
DamageCalculator ..> DamageResult : renvoie
TypeChart ..> Effectiveness

TeamDrafter ..|> TeamGenerator
TeamDrafter --> "1" SpeciesRepository

RandomOpponent ..|> Opponent
RandomOpponent ..> PlayerAction : renvoie

InMemorySpeciesRepository ..|> SpeciesRepository
JsonSpeciesRepository ..|> SpeciesRepository
JsonSpeciesRepository --> "1" SpeciesFactory
BundledRoster ..> SpeciesFactory : reconstruit le catalogue intégré
BundledRoster ..> InMemorySpeciesRepository : renvoie

CombatScreen ..|> BattleListener
CombatScreen --> BattleEngine : submitAction

legend bottom left
  <b>Observer (BattleListener)</b> : l'écran écoute l'arbitre, comme au jour 08. L'arbitre ne connaît pas l'écran.
  <b>Strategy (Opponent)</b> : l'arbitre interroge un adversaire, sans savoir si c'est l'IA ou le réseau.
  <b>Factory (SpeciesFactory)</b> : crée les espèces et les attaques à partir du JSON, comme au jour 08.
  <b>Random</b> : le même sert à tous les tirages, pour qu'une graine fixée rende les tests reproductibles.
  <b>BattlePhase</b> : submitAction lève IllegalStateException si l'action ne correspond pas à la phase.
  <b>Statuts (#32)</b> : l'état décide du blocage, des blessures ou des dégâts résiduels ; le moteur applique les PV, les K.O. et émet les événements.
  <b>MoveCategory.STATUS</b> : aucun dégât direct, aucun critique ; précision puis application du statut.
  <b>TypeChart</b> renvoie Optional.empty() pour une efficacité normale de ×1.
  <b>Catalogue JSON</b> charge le roster intégré et les fichiers utilisateur. add valide la fiche et copie les médias avant la sauvegarde.
endlegend
@enduml
